# ─────────────────────────────────────────────────────────────────────────────
# Accentra server environment variables
# Copy this file to server/.env and fill in the values:
#     Copy-Item server\.env.example server\.env
# NEVER commit server/.env and NEVER paste its contents into an AI chat.
# ─────────────────────────────────────────────────────────────────────────────

# Which mode the server runs in: development | test | production
NODE_ENV=development

# Port the API listens on. The Vite dev server proxies /api to this port.
PORT=5000

# MongoDB connection string (REQUIRED).
# Get it from MongoDB Atlas → your cluster → Connect → Drivers.
# Put the database name "accentra_dev" before the "?", for example:
#   mongodb+srv://accentra_dev:<password>@cluster0.xxxxx.mongodb.net/accentra_dev?retryWrites=true&w=majority
# URL-encode special characters in the password (@ : / ? #) or generate one without them.
MONGODB_URI=mongodb+srv://accentra_dev:<password>@cluster0.xxxxx.mongodb.net/accentra_dev?retryWrites=true&w=majority

# The URL of the React client. Only this origin may call the API (CORS).
CLIENT_ORIGIN=http://localhost:5173
